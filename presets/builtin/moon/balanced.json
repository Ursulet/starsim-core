      }
    },
    {
      "id": "core.contrast",
      "enabled": true,
      "parameters": {
        "factor": 1.07
      }
    },
    {
      "id": "core.gamma",
      "enabled": true,
      "parameters": {
        "gamma": 1
      }
    },
    {
      "id": "core.rgb-balance",
