<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StarSimCore.UI.ViewModels"
        xmlns:loc="using:StarSimCore.UI.Localization"
        x:Class="StarSimCore.UI.HelpWindow"
        x:DataType="vm:HelpWindowViewModel"
        Title="{loc:Localize Key=Help.Title}"
        Icon="avares://StarSimCore.UI/Assets/starsim-core-icon.png"
        Width="1020" Height="780" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="82,*,56">
    <Border Classes="panel-header" Padding="18,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="44" Height="44" CornerRadius="9" Background="#102B3E" BorderBrush="#245978" BorderThickness="1" Margin="0,0,13,0">
          <TextBlock Text="✦" FontSize="23" Foreground="#83CCFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="{loc:Localize Key=Help.Header}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{loc:Localize Key=Help.Subtitle}" Foreground="#7899B1" FontSize="10.5" />
        </StackPanel>
        <Border Grid.Column="2" Background="#0B1822" BorderBrush="#24445A" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
          <TextBlock Text="{Binding VersionText}" Foreground="#9CC8E5" FontSize="10" />
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="14">
      <TabItem Header="{loc:Localize Key=Help.Tab.About}">
        <ScrollViewer Margin="15" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" Margin="4,4,14,18">
            <TextBlock Text="{loc:Localize Key=Help.About.Title}" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Localize Key=Help.About.Body}" FontSize="12" LineHeight="19" TextWrapping="Wrap" />
            <Border Background="#081923" BorderBrush="#2B6281" BorderThickness="1" CornerRadius="9" Padding="16">
              <Grid ColumnDefinitions="190,*" ColumnSpacing="18">
                <Border Background="#02070B" BorderBrush="#1D3E53" BorderThickness="1" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                  <Image Source="avares://StarSimCore.UI/Assets/starsim-association-logo.png"
                         MaxWidth="172" MaxHeight="205" Stretch="Uniform"
                         ToolTip.Tip="{loc:Localize Key=Help.About.Support.LogoTip}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="9" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Localize Key=Help.About.Support.Title}" FontSize="17" FontWeight="SemiBold" Foreground="#E7B84B" />
                  <TextBlock Text="{loc:Localize Key=Help.About.Support.Body}" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
                  <TextBlock Text="{loc:Localize Key=Help.About.Support.Credit}" Foreground="#9CC8E5" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
                  <Button Content="{loc:Localize Key=Help.About.Support.Button}"
                          Click="OpenAssociationWebsite_Click" Classes="primary"
                          HorizontalAlignment="Left" MinWidth="210" Margin="0,3,0,0" />
                  <TextBlock Text="https://starsim.ro/" Foreground="#7899B1" FontSize="10" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="module-card" Padding="15">
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Localize Key=Help.About.Principles}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Localize Key=Help.About.NonDestructive}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Localize Key=Help.About.SharedPipeline}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Localize Key=Help.About.Float}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Localize Key=Help.About.Input}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="module-card" Padding="15">
              <StackPanel Spacing="9">
                <TextBlock Text="{loc:Localize Key=Help.Shortcuts.Title}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Localize Key=Help.Shortcuts.Intro}" Classes="secondary" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0,4,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HelpShortcutViewModel">
                      <Border BorderBrush="#183247" BorderThickness="0,0,0,1" Padding="2,6">
                        <Grid ColumnDefinitions="190,*" ColumnSpacing="12">
                          <Border Background="#07131D" BorderBrush="#28506A" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" MinWidth="170">
                            <TextBlock Text="{Binding Gesture}" FontFamily="Consolas" Foreground="#83CCFA" FontWeight="SemiBold" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Classes="module-card" Padding="15">
              <StackPanel Spacing="7">
                <TextBlock Text="{loc:Localize Key=Help.Batch.Title}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Localize Key=Help.Batch.Body}" Classes="secondary" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Localize Key=Help.Batch.Step1}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Localize Key=Help.Batch.Step2}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Localize Key=Help.Batch.Step3}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Localize Key=Help.Batch.Safety}" Foreground="#9CC8E5" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="#2A210F" BorderBrush="#E5A93C" BorderThickness="1" CornerRadius="7" Padding="13,10">
              <TextBlock Text="{loc:Localize Key=Help.About.Safety}" Foreground="#F5C467" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:Localize Key=Help.Tab.Beginner}">
        <ScrollViewer Margin="15" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" Margin="4,4,14,18">
            <TextBlock Text="{loc:Localize Key=Help.Beginner.Title}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Localize Key=Help.Beginner.Intro}" Classes="secondary" TextWrapping="Wrap" />
            <Border Classes="module-card" Padding="14"><StackPanel Spacing="5"><TextBlock Text="{loc:Localize Key=Help.Beginner.Step1.Title}" FontWeight="SemiBold" /><TextBlock Text="{loc:Localize Key=Help.Beginner.Step1.Body}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="module-card" Padding="14"><StackPanel Spacing="5"><TextBlock Text="{loc:Localize Key=Help.Beginner.Step2.Title}" FontWeight="SemiBold" /><TextBlock Text="{loc:Localize Key=Help.Beginner.Step2.Body}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="module-card" Padding="14"><StackPanel Spacing="5"><TextBlock Text="{loc:Localize Key=Help.Beginner.Step3.Title}" FontWeight="SemiBold" /><TextBlock Text="{loc:Localize Key=Help.Beginner.Step3.Body}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="module-card" Padding="14"><StackPanel Spacing="5"><TextBlock Text="{loc:Localize Key=Help.Beginner.Step4.Title}" FontWeight="SemiBold" /><TextBlock Text="{loc:Localize Key=Help.Beginner.Step4.Body}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="module-card" Padding="14"><StackPanel Spacing="5"><TextBlock Text="{loc:Localize Key=Help.Beginner.Step5.Title}" FontWeight="SemiBold" /><TextBlock Text="{loc:Localize Key=Help.Beginner.Step5.Body}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Background="#0B1822" BorderBrush="#24445A" BorderThickness="1" CornerRadius="7" Padding="13,10">
              <TextBlock Text="{loc:Localize Key=Help.Beginner.Tip}" Foreground="#9CC8E5" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:Localize Key=Help.Tab.Expert}">
        <ScrollViewer Margin="15" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" Margin="4,4,14,18">
            <TextBlock Text="{loc:Localize Key=Help.Expert.Title}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Localize Key=Help.Expert.Intro}" Classes="secondary" TextWrapping="Wrap" />
            <Border Background="#2A210F" BorderBrush="#E5A93C" BorderThickness="1" CornerRadius="7" Padding="13,10">
              <TextBlock Text="{loc:Localize Key=Help.Expert.Warning}" Foreground="#F5C467" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{loc:Localize Key=Help.Expert.PipelineOrder}" FontWeight="SemiBold" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding Modules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HelpModuleGuideViewModel">
                  <Border Classes="module-card" Padding="13" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="42,*">
                      <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Icon}" FontSize="20" Foreground="#83CCFA" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Order}" Classes="muted" FontSize="9" HorizontalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Foreground="#8FB0C6" FontSize="10.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Usage}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:Localize Key=Help.Tab.Plugins}">
        <ScrollViewer Margin="15" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="13" Margin="4,4,14,18">
            <TextBlock Text="{loc:Localize Key=Help.Plugins.Title}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Localize Key=Help.Plugins.Body}" TextWrapping="Wrap" LineHeight="18" />
            <Border Classes="module-card" Padding="14"><StackPanel Spacing="5"><TextBlock Text="{loc:Localize Key=Help.Plugins.Install.Title}" FontWeight="SemiBold" /><TextBlock Text="{loc:Localize Key=Help.Plugins.Install.Body}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="module-card" Padding="14"><StackPanel Spacing="5"><TextBlock Text="{loc:Localize Key=Help.Plugins.Panel.Title}" FontWeight="SemiBold" /><TextBlock Text="{loc:Localize Key=Help.Plugins.Panel.Body}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="module-card" Padding="14"><StackPanel Spacing="5"><TextBlock Text="{loc:Localize Key=Help.Plugins.Develop.Title}" FontWeight="SemiBold" /><TextBlock Text="{loc:Localize Key=Help.Plugins.Develop.Body}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Background="#2A210F" BorderBrush="#E5A93C" BorderThickness="1" CornerRadius="7" Padding="13,10"><TextBlock Text="{loc:Localize Key=Help.Plugins.Security}" Foreground="#F5C467" TextWrapping="Wrap" /></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#07121C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{loc:Localize Key=Help.Footer}" Classes="secondary" FontSize="10.5" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{loc:Localize Key=Common.Close}" Click="Close_Click" Classes="command" MinWidth="88" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
