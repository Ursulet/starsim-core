<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StarSimCore.UI.ViewModels"
        xmlns:controls="using:StarSimCore.UI.Controls"
        xmlns:loc="using:StarSimCore.UI.Localization"
        x:Class="StarSimCore.UI.HistogramToolWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Localize Key=Histogram.Title}"
        Icon="avares://StarSimCore.UI/Assets/starsim-core-icon.png"
        Width="760" Height="460" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="64,*,58">
    <Border Classes="panel-header" Padding="18,0">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="38" Height="38" CornerRadius="8" Background="#102B3E" BorderBrush="#245978" BorderThickness="1" Margin="0,0,12,0">
          <TextBlock Text="▥" FontSize="19" Foreground="#83CCFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{loc:Localize Key=Expert.Histogram}" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="{loc:Localize Key=Histogram.LiveDescription}" Foreground="#7899B1" FontSize="10.5" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="16" Background="#050C12" BorderBrush="#203748" BorderThickness="1" CornerRadius="7" Padding="6">
      <Grid>
        <controls:HistogramControl Data="{Binding Histogram}" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" IsVisible="{Binding !IsImageLoaded}">
          <TextBlock Text="{loc:Localize Key=Histogram.NoData}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Localize Key=Histogram.OpenImageHint}" Classes="muted" FontSize="10" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#07121C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
        <TextBlock Text="{Binding HistogramStats}" Foreground="#84A7C3" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="RGB" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="{loc:Localize Key=Common.Close}" Click="Close_Click" Classes="command" MinWidth="82" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
